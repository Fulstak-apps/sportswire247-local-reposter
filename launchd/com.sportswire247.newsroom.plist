<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.sportswire247.newsroom</string>
<key>ProgramArguments</key><array><string>/bin/zsh</string><string>__PROJECT_DIR__/scripts/run-local-newsroom.sh</string></array>
<key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
<key>RunAtLoad</key><true/><key>StartInterval</key><integer>300</integer>
<key>ThrottleInterval</key><integer>60</integer>
<key>StandardOutPath</key><string>__PROJECT_DIR__/runtime/logs/newsroom.out.log</string>
<key>StandardErrorPath</key><string>__PROJECT_DIR__/runtime/logs/newsroom.err.log</string>
</dict></plist>
