{
  "name": "local-sports-reposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "worker": "node src/worker.mjs",
    "collect": "node src/collect-only.mjs",
    "repost:monitor": "node scripts/instagram-repost-monitor.mjs",
    "mirror:login": "node scripts/instagram-browser-mirror.mjs login",
    "mirror:publish": "node scripts/instagram-browser-mirror.mjs publish",
    "dispatch": "bash scripts/dispatch-publisher.sh",
    "newsroom:dry-run": "python3 scripts/local-sportswire.py --dry-run",
    "newsroom:health": "python3 scripts/local-sportswire.py --health",
    "newsroom:install": "bash scripts/install-local-newsroom.sh",
    "login": "node src/cli.mjs login",
    "baseline": "node src/cli.mjs baseline",
    "start": "node src/cli.mjs start",
    "stop": "node src/cli.mjs stop",
    "status": "node src/cli.mjs status",
    "logs": "node src/cli.mjs logs",
    "retry": "node src/cli.mjs retry",
    "test": "node --test"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "engines": { "node": ">=20" }
}
